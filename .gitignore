**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Plataformas generadas localmente por `flutter create` (el repo solo
# versiona android/ y web/). Se regeneran con:
#   flutter create --platforms=ios,windows,linux,macos .
/ios/
/linux/
/macos/
/windows/
